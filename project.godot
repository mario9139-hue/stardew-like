; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Stardew-like Farm"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.3")

[autoload]

GameClock="*res://scenes/game_clock.tscn"
Money="*res://scripts/money.gd"
SalesLedger="*res://scripts/sales_ledger.gd"
PlayerStats="*res://scenes/player_stats.tscn"
Balance="*res://scripts/balance.gd"
DebugFlags="*res://scripts/debug_flags.gd"
SeasonStats="*res://scripts/season_stats.gd"
CarryOver="*res://scripts/carry_over.gd"
GameFlow="*res://scripts/game_flow.gd"
ItemRegistry="*res://scripts/item_registry.gd"
SaveManager="*res://scripts/save_manager.gd"
GameSetup="*res://scripts/game_setup.gd"

[display]

window/handheld/orientation=4
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[gui]

theme/custom_font="res://assets/fonts/NotoSansJP-Subset.otf"

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method.web="gl_compatibility"

